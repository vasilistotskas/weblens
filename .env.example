# Payment receiving address (USDC on Base mainnet)
# IMPORTANT: Must be different from payer addresses (CDP rejects self-payments)
PAY_TO_ADDRESS=0xYourPaymentReceivingAddress

# Network: "base" for mainnet (production), "base-sepolia" for testnet
NETWORK=base

# CDP API Keys (required for Bazaar discovery listing)
# Get these from https://portal.cdp.coinbase.com
# 1. Create account/sign in
# 2. Create a project
# 3. Go to API Keys → Secret API Keys → Create API key
CDP_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CDP_API_KEY_SECRET=your-secret-key-here

# Optional: seeds CDP Bazaar listings (pnpm run bootstrap-payment).
#
# YOU GENERATE THIS VALUE — it is not issued by Coinbase or PayAI. It is a
# shared secret between the deployed Worker and the bootstrap script: a request
# carrying it in `X-Bazaar-Bootstrap` settles through the CDP facilitator
# instead of PayAI, which is the only way a resource enters CDP's catalog
# (indexing is per-resource and driven by CDP's own settles). Leave unset and
# the header is ignored entirely — the CDP path stays unreachable.
#
#   Generate:  openssl rand -hex 32
#   PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
#   Deploy:    wrangler secret put BAZAAR_BOOTSTRAP_SECRET
#
# Then pass the SAME value to the script. The seeding wallet must not be
# PAY_TO_ADDRESS (CDP rejects self-payments, see the top of this file) and needs
# USDC only — no ETH. x402 settles via EIP-3009, so the facilitator submits the
# transaction and pays the gas, not the payer.
BAZAAR_BOOTSTRAP_SECRET=generate-your-own-random-string

# Optional: Anthropic API key for AI-powered extraction
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: SerpAPI key for better search results
SERP_API_KEY=xxx
