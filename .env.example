# Payment receiving address (USDC on Base mainnet)
# IMPORTANT: Must be different from payer addresses (CDP rejects self-payments)
PAY_TO_ADDRESS=0xYourPaymentReceivingAddress

# Network: "base" for mainnet (production), "base-sepolia" for testnet
NETWORK=base

# CDP API Keys (required: CDP settles Base payments first, see FACILITATORS_EVM in wrangler.toml)
# Get these from https://portal.cdp.coinbase.com
# 1. Create account/sign in
# 2. Create a project
# 3. Go to API Keys → Secret API Keys → Create API key
CDP_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CDP_API_KEY_SECRET=your-secret-key-here

# Optional: PayAI facilitator API key. Without it PayAI settles only within a
# free allowance per payout wallet; beyond it, settles are paid from the key's
# prepaid credits. Buy one over x402 (POST
# https://merchant.payai.network/api/v1/keys/vend?amount=5); the response shows
# the secret once. Set both or neither: PayAI rejects a bad credential.
#   Deploy:    wrangler secret put PAYAI_API_KEY_ID / PAYAI_API_KEY_SECRET
PAYAI_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYAI_API_KEY_SECRET=payai_sk_your-secret-here

# Optional: Anthropic API key for AI-powered extraction
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: SerpAPI key for better search results
SERP_API_KEY=xxx
