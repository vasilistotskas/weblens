{
  "name": "weblens",
  "version": "2.0.0",
  "description": "Premium Web Intelligence API with x402 micropayments — web scraping, screenshots, data extraction, AI research for autonomous agents",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-scraping",
    "x402",
    "micropayments",
    "ai-agent",
    "web-intelligence",
    "data-extraction",
    "cloudflare-workers",
    "usdc",
    "hono"
  ],
  "homepage": "https://api.weblens.dev",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && tsc --noEmit -p scripts",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "verify-bazaar": "npx tsx scripts/verify-bazaar.ts",
    "bootstrap-payment": "npx tsx scripts/bootstrap-payment.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@coinbase/x402": "^2.1.0",
    "@scalar/hono-api-reference": "^0.12.10",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "hono": "^4.13.13",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@hono/eslint-config": "^2.1.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@x402/axios": "^2.28.0",
    "axios": "^1.20.0",
    "eslint": "10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.9.1"
}
